<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">


    <!-- 1. Splash Screen with Session Routing -->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.lankago.fragments.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_discoverFragment"
            app:destination="@id/discoverFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 2. Discover Screen (Onboarding 1) -->
    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.example.lankago.fragments.DiscoverFragment"
        android:label="Discover"
        tools:layout="@layout/discover">
        <action
            android:id="@+id/action_discoverFragment_to_experienceFragment"
            app:destination="@id/experienceFragment" />
        <action
            android:id="@+id/action_discoverFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/discoverFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 3. Experience Screen (Onboarding 2) -->
    <fragment
        android:id="@+id/experienceFragment"
        android:name="com.example.lankago.fragments.ExperienceFragment"
        android:label="Experience"
        tools:layout="@layout/experience">
        <action
            android:id="@+id/action_experienceFragment_to_rentalsOnboardingFragment"
            app:destination="@id/rentalsOnboardingFragment" />
        <action
            android:id="@+id/action_experienceFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/discoverFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 4. Rentals Onboarding Screen (Onboarding 3) -->
    <fragment
        android:id="@+id/rentalsOnboardingFragment"
        android:name="com.example.lankago.fragments.RentalsOnboardingFragment"
        android:label="Rentals Onboarding"
        tools:layout="@layout/onboarding_rentals">
        <action
            android:id="@+id/action_rentalsOnboardingFragment_to_planOnboardingFragment"
            app:destination="@id/planOnboardingFragment" />
        <action
            android:id="@+id/action_rentalsOnboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/discoverFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 5. Plan Onboarding Screen (Onboarding 4) -->
    <fragment
        android:id="@+id/planOnboardingFragment"
        android:name="com.example.lankago.fragments.PlanOnboardingFragment"
        android:label="Plan Onboarding"
        tools:layout="@layout/onboarding_plan">
        <action
            android:id="@+id/action_planOnboardingFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/discoverFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 4. Plan Trip Screen -->
    <fragment
        android:id="@+id/planTripFragment"
        android:name="com.example.lankago.fragments.PlanTripFragment"
        android:label="Plan Trip"
        tools:layout="@layout/fragment_plan_trip">

        <action
            android:id="@+id/action_planTripFragment_to_rentalShopsListFragment"
            app:destination="@id/rentalShopsListFragment" />
        <action
            android:id="@+id/action_planTripFragment_to_rentalListFragment"
            app:destination="@id/rentalListFragment" />
        <action
            android:id="@+id/action_planTripFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_planTripFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_planTripFragment_to_rentalsTransportFragment"
            app:destination="@id/rentalsTransportFragment" />
        <action
            android:id="@+id/action_planTripFragment_to_tripHistoryFragment"
            app:destination="@id/tripHistoryFragment" />
    </fragment>

    <!-- 5. Login Screen -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.lankago.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_adminLoginFragment"
            app:destination="@id/adminLoginFragment" />
        <action
            android:id="@+id/action_loginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 6. Register Screen -->
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.lankago.fragments.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 7. Home Screen -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.lankago.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/home">
        <action
            android:id="@+id/action_homeFragment_to_discoverFragment"
            app:destination="@id/discoverFragment" />
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_localProductsFragment"
            app:destination="@id/localProductsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_traditionalActivitiesFragment"
            app:destination="@id/traditionalActivitiesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_showsAndFestivalsFragment"
            app:destination="@id/showsAndFestivalsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_rentalsTransportFragment"
            app:destination="@id/rentalsTransportFragment" />

        <action
            android:id="@+id/action_homeFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_homeFragment_to_tripPlannerFragment"
            app:destination="@id/tripPlannerFragment" />
        <action
            android:id="@+id/action_homeFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_destinationDetailFragment"
            app:destination="@id/destinationDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_rentalDetailsFragment"
            app:destination="@id/rentalDetailsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_activityBookingFragment"
            app:destination="@id/activityBookingFragment" />
        <action
            android:id="@+id/action_homeFragment_to_traditionalActivityDetailFragment"
            app:destination="@id/traditionalActivityDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_festivalDetailFragment"
            app:destination="@id/festivalDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_planTripFragment"
            app:destination="@id/planTripFragment" />
        <action
            android:id="@+id/action_homeFragment_to_mapRouteFragment"
            app:destination="@id/mapRouteFragment" />
        <action
            android:id="@+id/action_homeFragment_to_rentalListFragment"
            app:destination="@id/rentalListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_rentalShopsListFragment"
            app:destination="@id/rentalShopsListFragment" />
    </fragment>

    <!-- Destination Fragments (Teammate Fragments & Feature Screens) -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.lankago.fragments.SearchFragment"
        android:label="Search"
        tools:layout="@layout/search">
        <action
            android:id="@+id/action_searchFragment_to_destinationDetailFragment"
            app:destination="@id/destinationDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/destinationDetailFragment"
        android:name="com.example.lankago.fragments.DestinationDetailFragment"
        android:label="Destination Detail"
        tools:layout="@layout/destination_detail">
        <action
            android:id="@+id/action_destinationDetailFragment_to_planTripFragment"
            app:destination="@id/planTripFragment" />
        <action
            android:id="@+id/action_destinationDetailFragment_to_mapRouteFragment"
            app:destination="@id/mapRouteFragment" />
        <action
            android:id="@+id/action_destinationDetailFragment_to_rentalListFragment"
            app:destination="@id/rentalListFragment" />
    </fragment>

    <fragment
        android:id="@+id/localProductsFragment"
        android:name="com.example.lankago.fragments.LocalProductsFragment"
        android:label="Local Products"
        tools:layout="@layout/local_products">
        <action
            android:id="@+id/action_localProductsFragment_to_localItemDetailsFragment"
            app:destination="@id/localItemDetailsFragment" />
        <action
            android:id="@+id/action_localProductsFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_localProductsFragment_to_mapRouteFragment"
            app:destination="@id/mapRouteFragment" />
        <action
            android:id="@+id/action_localProductsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/traditionalActivitiesFragment"
        android:name="com.example.lankago.fragments.TraditionalActivitiesFragment"
        android:label="Traditional Activities"
        tools:layout="@layout/traditional_activities">
        <action
            android:id="@+id/action_traditionalActivitiesFragment_to_traditionalActivityDetailFragment"
            app:destination="@id/traditionalActivityDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/showsAndFestivalsFragment"
        android:name="com.example.lankago.fragments.ShowsAndFestivalsFragment"
        android:label="Shows &amp; Festivals"
        tools:layout="@layout/shows_and_festivals">
        <action
            android:id="@+id/action_showsAndFestivalsFragment_to_festivalDetailFragment"
            app:destination="@id/festivalDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/rentalsTransportFragment"
        android:name="com.example.lankago.fragments.RentalsTransportFragment"
        android:label="Rentals &amp; Transport"
        tools:layout="@layout/rentals_and_transport">
        <action
            android:id="@+id/action_rentalsTransportFragment_to_shopDetailsFragment"
            app:destination="@id/shopDetailsFragment" />
        <action
            android:id="@+id/action_rentalsTransportFragment_to_rentalDetailsFragment"
            app:destination="@id/rentalDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.example.lankago.fragments.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/notifications" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.lankago.fragments.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_profileFragment_to_offlineSavedFragment"
            app:destination="@id/offlineSavedFragment" />
        <action
            android:id="@+id/action_profileFragment_to_reviewsFragment"
            app:destination="@id/reviewsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_profileFragment_to_rentalListFragment"
            app:destination="@id/rentalListFragment" />
        <action
            android:id="@+id/action_profileFragment_to_tripHistoryFragment"
            app:destination="@id/tripHistoryFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/tripPlannerFragment"
        android:name="com.example.lankago.fragments.TripPlannerFragment"
        android:label="Trip Planner"
        tools:layout="@layout/trip_planner">
        <action
            android:id="@+id/action_tripPlannerFragment_to_rentalDetailsFragment"
            app:destination="@id/rentalDetailsFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_activityBookingFragment"
            app:destination="@id/activityBookingFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_planTripFragment"
            app:destination="@id/planTripFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_rentalListFragment"
            app:destination="@id/rentalListFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_traditionalActivitiesFragment"
            app:destination="@id/traditionalActivitiesFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_tripHistoryFragment"
            app:destination="@id/tripHistoryFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_createTripFragment"
            app:destination="@id/createTripFragment" />
        <action
            android:id="@+id/action_tripPlannerFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.lankago.fragments.FavoritesFragment"
        android:label="Favorites"
        tools:layout="@layout/favorites">
        <action
            android:id="@+id/action_favoritesFragment_to_destinationDetailFragment"
            app:destination="@id/destinationDetailFragment" />
        <action
            android:id="@+id/action_favoritesFragment_to_discoverFragment"
            app:destination="@id/discoverFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.lankago.fragments.ForgotPasswordFragment"
        android:label="Forgot Password"
        tools:layout="@layout/forgot_password">
        <action
            android:id="@+id/action_forgotPasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mapRouteFragment"
        android:name="com.example.lankago.fragments.MapRouteFragment"
        android:label="Map Route"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/offlineSavedFragment"
        android:name="com.example.lankago.fragments.OfflineSavedFragment"
        android:label="Offline Saved"
        tools:layout="@layout/offline_saved" />

    <fragment
        android:id="@+id/reviewsFragment"
        android:name="com.example.lankago.fragments.ReviewsFragment"
        android:label="Reviews"
        tools:layout="@layout/reviews" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.lankago.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/settings">
        <action
            android:id="@+id/action_settingsFragment_to_notificationsFragment"
            app:destination="@id/notificationsFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_mapRouteFragment"
            app:destination="@id/mapRouteFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_offlineSavedFragment"
            app:destination="@id/offlineSavedFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_favoritesFragment"
            app:destination="@id/favoritesFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_rentalsTransportFragment"
            app:destination="@id/rentalsTransportFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <!-- ==================== ADMIN PANEL DESTINATIONS ==================== -->

    <fragment
        android:id="@+id/adminLoginFragment"
        android:name="com.example.lankago.fragments.admin.AdminLoginFragment"
        android:label="Admin Login"
        tools:layout="@layout/fragment_admin_login">
        <action
            android:id="@+id/action_adminLoginFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/adminLoginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_adminLoginFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/adminLoginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.lankago.fragments.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminRentalListFragment"
            app:destination="@id/adminRentalListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminProductListFragment"
            app:destination="@id/adminProductListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminActivityListFragment"
            app:destination="@id/adminActivityListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminPlaceListFragment"
            app:destination="@id/adminPlaceListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminFestivalListFragment"
            app:destination="@id/adminFestivalListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminBookingsListFragment"
            app:destination="@id/adminBookingsListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminManageUsersFragment"
            app:destination="@id/adminManageUsersFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminManageVendorsFragment"
            app:destination="@id/adminManageVendorsFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminManageContentFragment"
            app:destination="@id/adminManageContentFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminAddDestinationFragment"
            app:destination="@id/adminAddDestinationFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminPushNotificationsFragment"
            app:destination="@id/adminPushNotificationsFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminLoginFragment"
            app:destination="@id/adminLoginFragment"
            app:popUpTo="@id/adminLoginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/adminDashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminManageUsersFragment"
        android:name="com.example.lankago.fragments.admin.AdminManageUsersFragment"
        android:label="Manage Users"
        tools:layout="@layout/admin_manage_users" />

    <fragment
        android:id="@+id/adminManageVendorsFragment"
        android:name="com.example.lankago.fragments.admin.AdminManageVendorsFragment"
        android:label="Manage Vendors"
        tools:layout="@layout/admin_manage_vendors" />

    <fragment
        android:id="@+id/adminManageContentFragment"
        android:name="com.example.lankago.fragments.admin.AdminManageContentFragment"
        android:label="Manage Content"
        tools:layout="@layout/admin_manage_content" />

    <fragment
        android:id="@+id/adminAddDestinationFragment"
        android:name="com.example.lankago.fragments.admin.AdminAddDestinationFragment"
        android:label="Add Destination"
        tools:layout="@layout/admin_add_destination" />

    <fragment
        android:id="@+id/adminPushNotificationsFragment"
        android:name="com.example.lankago.fragments.admin.AdminPushNotificationsFragment"
        android:label="Push Notifications"
        tools:layout="@layout/admin_push_notifications" />

    <!-- Admin Manage Rentals Flow -->
    <fragment
        android:id="@+id/adminRentalListFragment"
        android:name="com.example.lankago.fragments.admin.AdminRentalListFragment"
        android:label="Manage Rentals"
        tools:layout="@layout/fragment_admin_rental_list">
        <action
            android:id="@+id/action_adminRentalListFragment_to_addEditRentalFragment"
            app:destination="@id/addEditRentalFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditRentalFragment"
        android:name="com.example.lankago.fragments.admin.AddEditRentalFragment"
        android:label="Add / Edit Rental"
        tools:layout="@layout/fragment_add_edit_rental">
        <argument
            android:name="rentalShopId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Admin Manage Products Flow -->
    <fragment
        android:id="@+id/adminProductListFragment"
        android:name="com.example.lankago.fragments.admin.AdminProductListFragment"
        android:label="Manage Products"
        tools:layout="@layout/fragment_admin_product_list">
        <action
            android:id="@+id/action_adminProductListFragment_to_addEditProductFragment"
            app:destination="@id/addEditProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditProductFragment"
        android:name="com.example.lankago.fragments.admin.AddEditProductFragment"
        android:label="Add / Edit Product"
        tools:layout="@layout/fragment_add_edit_product">
        <argument
            android:name="productId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Admin Manage Activities Flow -->
    <fragment
        android:id="@+id/adminActivityListFragment"
        android:name="com.example.lankago.fragments.admin.AdminActivityListFragment"
        android:label="Manage Activities"
        tools:layout="@layout/fragment_admin_activity_list">
        <action
            android:id="@+id/action_adminActivityListFragment_to_addEditActivityFragment"
            app:destination="@id/addEditActivityFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditActivityFragment"
        android:name="com.example.lankago.fragments.admin.AddEditActivityFragment"
        android:label="Add / Edit Activity"
        tools:layout="@layout/fragment_add_edit_activity">
        <argument
            android:name="activityId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Admin View User Bookings Screen -->
    <fragment
        android:id="@+id/adminBookingsListFragment"
        android:name="com.example.lankago.fragments.admin.AdminBookingsListFragment"
        android:label="User Bookings"
        tools:layout="@layout/fragment_admin_bookings_list" />

    <!-- Admin Manage Places / Destinations Flow -->
    <fragment
        android:id="@+id/adminPlaceListFragment"
        android:name="com.example.lankago.fragments.admin.AdminPlaceListFragment"
        android:label="Manage Destinations"
        tools:layout="@layout/fragment_admin_place_list">
        <action
            android:id="@+id/action_adminPlaceListFragment_to_addEditPlaceFragment"
            app:destination="@id/addEditPlaceFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditPlaceFragment"
        android:name="com.example.lankago.fragments.admin.AddEditPlaceFragment"
        android:label="Add / Edit Destination"
        tools:layout="@layout/fragment_add_edit_place">
        <argument
            android:name="placeId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- Admin Manage Shows & Festivals Flow -->
    <fragment
        android:id="@+id/adminFestivalListFragment"
        android:name="com.example.lankago.fragments.admin.AdminFestivalListFragment"
