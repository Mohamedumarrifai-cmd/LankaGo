<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_admin"
    app:startDestination="@id/adminDashboardFragment">

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.lankago.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminRentalListFragment"
            app:destination="@id/adminRentalListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminProductListFragment"
            app:destination="@id/adminProductListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminActivityListFragment"
            app:destination="@id/adminActivityListFragment" />
        <action
            android:id="@+id/action_adminDashboardFragment_to_adminUserBookingsFragment"
            app:destination="@id/adminUserBookingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminRentalListFragment"
        android:name="com.example.lankago.admin.AdminRentalListFragment"
        android:label="Manage Rentals"
        tools:layout="@layout/fragment_admin_rental_list">
        <action
            android:id="@+id/action_adminRentalListFragment_to_addEditRentalFragment"
            app:destination="@id/addEditRentalFragment" />
    </fragment>

    <fragment
        android:id="@+id/addEditRentalFragment"
        android:name="com.example.lankago.admin.AddEditRentalFragment"
        android:label="Add / Edit Rental">
        <argument
            android:name="rentalId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/adminProductListFragment"
        android:name="com.example.lankago.admin.AdminProductListFragment"
        android:label="Manage Products" />

    <fragment
        android:id="@+id/adminActivityListFragment"
        android:name="com.example.lankago.admin.AdminActivityListFragment"
        android:label="Manage Activities" />

    <fragment
        android:id="@+id/adminUserBookingsFragment"
        android:name="com.example.lankago.admin.AdminUserBookingsFragment"
        android:label="User Bookings" />

</navigation>
