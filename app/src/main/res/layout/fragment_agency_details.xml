<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_agency_details"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_agency"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/admin_primary_navy"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="@color/admin_primary_navy">

            <!-- High-Res Cover Image of the Place/Agency -->
            <ImageView
                android:id="@+id/iv_agency_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Agency cover image"
                android:fitsSystemWindows="true"
                android:scaleType="centerCrop"
                android:src="@drawable/casons_rent"
                app:layout_collapseMode="parallax" />

            <!-- Dark Gradient Scrim Overlay for contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/top_gradient_bg" />

            <!-- Top Toolbar with Back and Action Icons -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_agency_details"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tv_toolbar_agency_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="Galle Bike &amp; Scooter Hub" />

                    <ImageButton
                        android:id="@+id/btn_agency_share"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_heart_button"
                        android:contentDescription="Share Agency"
                        android:padding="6dp"
                        android:src="@drawable/ic_send"
                        app:tint="@color/admin_primary_navy" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrolling Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="48dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Verified Badge Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_agency_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    tools:text="Galle Bike &amp; Scooter Hub" />

                <LinearLayout
                    android:id="@+id/layout_verified_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_approved"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_verified_badge"
                        app:tint="@color/admin_success" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="VERIFIED"
                        android:textColor="@color/admin_success"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tagline -->
            <TextView
                android:id="@+id/tv_agency_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Southern Coast's Premier Two-Wheeler Specialists" />

            <!-- Rating, City, Price Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/rating_gold" />

                <TextView
                    android:id="@+id/tv_agency_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="4.9" />

                <TextView
                    android:id="@+id/tv_agency_review_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="(184 reviews)" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/dot_active" />

                <TextView
                    android:id="@+id/tv_agency_city"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/admin_accent_indigo"
                    android:textSize="13sp"
                    tools:text="Galle, Southern Province" />

                <TextView
                    android:id="@+id/tv_agency_price_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/admin_primary_navy"
                    android:textSize="12sp"
                    tools:text="$12 – $35 / Day" />
            </LinearLayout>

            <!-- DIRECT ACTION BUTTONS (WhatsApp, Call, Website) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/admin_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-black"
                        android:text="Direct Agency Contact"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- 1. WhatsApp Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_contact_whatsapp"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/whatsapp_green"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="WhatsApp"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_whatsapp"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/white" />

                        <!-- 2. Call Now Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_contact_call"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:backgroundTint="@color/admin_primary_navy"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Call Now"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_phone_call"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/white" />

                        <!-- 3. Visit Website Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_contact_website"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Website"
                            android:textAllCaps="false"
                            android:textColor="@color/admin_primary_navy"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_globe_web"
                            app:iconGravity="textStart"
                            app:iconSize="18dp"
                            app:iconTint="@color/admin_primary_navy"
                            app:strokeColor="@color/admin_primary_navy"
                            app:strokeWidth="1.5dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location & Hours Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/admin_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/admin_accent_indigo" />

                        <TextView
                            android:id="@+id/tv_agency_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="No. 42 Light House Street, Galle Fort, Sri Lanka" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/admin_border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/admin_success" />

                        <TextView
                            android:id="@+id/tv_agency_hours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="Open Daily: 07:30 AM – 09:30 PM" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Available Fleet / Services Chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="Available Fleet &amp; Vehicles"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_fleet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- About Agency Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="About Agency"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_agency_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Galle Bike &amp; Scooter Hub is Southern Sri Lanka's leading verified rental agency. Offering well-serviced automatic scooters, dual-sport adventure bikes, and classic cruisers for touring the southern coastline. Full comprehensive insurance, roadside assistance, and certified helmets provided with every rental." />

            <!-- NEARBY AGENCIES HORIZONTAL SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="Nearby Agencies &amp; Hubs"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_see_all_nearby"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="See All"
                    android:textColor="@color/admin_accent_indigo"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_nearby_agencies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_nearby_agency_card" />

            <!-- USER REVIEWS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="User Reviews &amp; Ratings"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_write_review"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="+ Write Review"
                    android:textColor="@color/admin_accent_indigo"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Reviews List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_agency_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_agency_review" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
