<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F8F9FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar Initial Box -->
            <TextView
                android:id="@+id/tv_avatar_initial"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_category_tag"
                android:gravity="center"
                android:fontFamily="sans-serif-black"
                android:textColor="#1A2B4C"
                android:textSize="15sp"
                tools:text="S" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_reviewer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#1A2B4C"
                    android:textSize="14sp"
                    tools:text="Sarah Jenkins" />

                <TextView
                    android:id="@+id/tv_review_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#8A8F98"
                    android:textSize="11sp"
                    tools:text="12 Oct 2026" />
            </LinearLayout>

            <!-- Star Rating Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="#FEF3C7"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@android:drawable/star_on" />

                <TextView
                    android:id="@+id/tv_review_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#B45309"
                    android:textSize="12sp"
                    tools:text="5.0" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_review_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#475569"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            tools:text="Smooth engine for climbing Little Adam's Peak roads. Helmets were spotless." />
    </LinearLayout>
</androidx.cardview.widget.CardView>
