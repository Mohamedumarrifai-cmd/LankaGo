<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_vendor_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/admin_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header: Store Image, Info & Glowing Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Vendor Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#1F5D5FEF">

                <ImageView
                    android:id="@+id/iv_vendor_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/pottery"
                    android:contentDescription="Vendor Store" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Vendor Titles -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_vendor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Ceylon Artisan Pottery"
                    android:textColor="#1A2B4C"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_vendor_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Handicrafts • Kandy"
                    android:textColor="#8A8F98"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Glowing Status Badge -->
            <TextView
                android:id="@+id/tv_vendor_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pending"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Pending"
                android:textColor="#B45309"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#F1F5F9" />

        <!-- Application Details Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Registration ID"
                    android:textColor="#8A8F98"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_vendor_reg_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="#LK-9824"
                    android:textColor="#1A2B4C"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Date Submitted"
                    android:textColor="#8A8F98"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_vendor_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Oct 18, 2026"
                    android:textColor="#1A2B4C"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons (Approve & Reject) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Reject Button (Soft Red) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_reject_vendor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_btn_reject_soft"
                android:fontFamily="sans-serif-black"
                android:text="Reject"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="13sp" />

            <!-- Approve Button (Soft Green) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_approve_vendor"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_approve_soft"
                android:fontFamily="sans-serif-black"
                android:text="Approve"
                android:textAllCaps="false"
                android:textColor="#10B981"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
