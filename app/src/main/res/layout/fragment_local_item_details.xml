<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_local_item"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_local_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="@color/admin_primary_navy"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:statusBarScrim="@color/admin_primary_navy">

            <!-- High-Quality Cover Image -->
            <ImageView
                android:id="@+id/iv_local_item_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Local item cover image"
                android:fitsSystemWindows="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ceylon_tea_set"
                app:layout_collapseMode="parallax" />

            <!-- Dark Gradient Scrim Overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/top_gradient_bg" />

            <!-- Top Toolbar with Back and Action Icons -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_local_item"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tv_toolbar_item_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        tools:text="Pure Ceylon Tea" />

                    <ImageButton
                        android:id="@+id/btn_item_favorite"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_heart_button"
                        android:contentDescription="Bookmark Item"
                        android:padding="6dp"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="@color/admin_danger" />
                </RelativeLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Details -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Category Badge & Origin Region -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_category_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_tag"
                    android:fontFamily="sans-serif-bold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/admin_accent_indigo"
                    android:textSize="11sp"
                    tools:text="LOCAL PRODUCTS" />

                <TextView
                    android:id="@+id/tv_item_region"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Origin: Nuwara Eliya &amp; Central Highlands" />
            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                tools:text="Pure Ceylon Single-Estate Black Tea &amp; Silver Tips" />

            <!-- Price & Rating Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/rating_gold" />

                <TextView
                    android:id="@+id/tv_item_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="4.95" />

                <TextView
                    android:id="@+id/tv_item_review_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="(340 reviews)" />

                <TextView
                    android:id="@+id/tv_item_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="end"
                    android:textColor="@color/admin_primary_navy"
                    android:textSize="13sp"
                    tools:text="LKR 1,500 – 6,500" />
            </LinearLayout>

            <!-- Short Overview -->
            <TextView
                android:id="@+id/tv_item_short_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Handpicked high-altitude orthodox black tea celebrated globally for delicate golden liquor, aroma, and natural antioxidants." />

            <!-- SECTION 1: WHY IT IS IMPORTANT? (Cultural & Historical Significance) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_why_important"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/heritage_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/heritage_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_sparkle"
                            app:tint="@color/cultural_gold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Why It Is Important?"
                            android:textColor="@color/cultural_gold"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Cultural &amp; Historical Significance"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/heritage_card_stroke" />

                    <TextView
                        android:id="@+id/tv_item_importance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        tools:text="Ceylon Tea remains one of Sri Lanka's greatest pride and cultural emblems. Introduced in 1867 by James Taylor at Loolecondera Estate, the unique climate of Sri Lanka's misty central highlands produces distinctive polyphenols and flavor profiles that cannot be replicated anywhere else on earth. Drinking Ceylon tea is woven into every household's daily rhythm and represents genuine Sri Lankan hospitality." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: WHERE TO BUY / MARKET AVAILABILITY -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_market_availability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/market_card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/market_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_store"
                            app:tint="@color/admin_success" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-black"
                            android:text="Market Availability / Where to Buy"
                            android:textColor="@color/admin_success"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Authentic Local Stalls &amp; Verified Vendors"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/market_card_stroke" />

                    <!-- Detailed Location Description -->
                    <TextView
                        android:id="@+id/tv_item_market_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        tools:text="Available at heritage tea factory boutique outlets in Nuwara Eliya, Mlesna Tea Fortress (Kiribathkumbura), and the Ceylon Tea Museum sales counter in Hantana." />

                    <!-- Precise Address with Map Pin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_map_pin"
                            app:tint="@color/admin_primary_navy" />

                        <TextView
                            android:id="@+id/tv_item_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/admin_primary_navy"
                            android:textSize="13sp"
                            tools:text="Hantana Estate, Kandy / Pedro Tea Estate, Nuwara Eliya" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tags / Cultural Keywords -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-black"
                android:text="Cultural Tags &amp; Features"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_item_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FLOATING BOTTOM BAR WITH "EXPLORE ON MAP" BUTTON -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_bar_explore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/admin_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_bottom_item_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="Pure Ceylon Tea" />

                <TextView
                    android:id="@+id/tv_bottom_coordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="6.9497° N, 80.7891° E" />
            </LinearLayout>

            <!-- EXPLORE ON MAP BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_explore_on_map"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="@color/admin_primary_navy"
                android:fontFamily="sans-serif-bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="20dp"
                android:text="Explore on Map"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_map_pin"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
