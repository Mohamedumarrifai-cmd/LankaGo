<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB">

    <!-- Bookings RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_page_bookings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="12dp"
        tools:listitem="@layout/item_admin_booking" />

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pb_page_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#5D5FEF"
        android:visibility="gone" />

    <!-- Empty State UI -->
    <LinearLayout
        android:id="@+id/layout_empty_page_bookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="No Bookings"
            android:src="@drawable/ic_calendar"
            app:tint="#8A8F98" />

        <TextView
            android:id="@+id/tv_empty_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="No Bookings Found"
            android:textColor="#1A2B4C"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_empty_page_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Customer reservations created via the LankaGo app will appear in real time here."
            android:textColor="#8A8F98"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
