<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Festival Banner Thumbnail -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_admin_festival_thumb"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="Festival Banner"
                android:scaleType="centerCrop"
                android:src="@drawable/kandy_esala"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Festival Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_admin_festival_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="#1A2B4C"
                    android:textSize="16sp"
                    tools:text="Kandy Esala Perahera" />

                <!-- Category Badge & Rating -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_admin_festival_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_approved"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="#F59E0B"
                        android:textSize="11sp"
                        tools:text="Sacred Buddhist Pageant" />

                    <TextView
                        android:id="@+id/tv_admin_festival_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        tools:text="★ 4.9" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_admin_festival_dates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#5D5FEF"
                    android:textSize="12sp"
                    tools:text="August 15 - August 25, 2026" />

                <TextView
                    android:id="@+id/tv_admin_festival_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="#8A8F98"
                    android:textSize="12sp"
                    tools:text="Temple of the Tooth Relic, Kandy" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#F0F2F5" />

        <!-- Bottom Action Bar (Edit & Delete) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_admin_festival_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#A0AEC0"
                android:textSize="11sp"
                tools:text="ID: fest_kandy_perahera" />

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_festival"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-bold"
                android:text="Edit"
                android:textColor="#5D5FEF"
                android:textSize="12sp"
                app:icon="@drawable/ic_admin_edit"
                app:iconTint="#5D5FEF" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_festival"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Delete"
                android:textColor="#EF4444"
                android:textSize="12sp"
                app:icon="@drawable/ic_admin_delete"
                app:iconTint="#EF4444" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
