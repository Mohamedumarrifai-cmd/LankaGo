<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. TOP BAR -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1A2B4C"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Rentals &amp; Transport"
            android:textColor="#1A2B4C"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 2. FILTER CHIPS -->
    <HorizontalScrollView
        android:id="@+id/scroll_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_active"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_scooters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_inactive"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Scooters"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chip_bikes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_inactive"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Bikes"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chip_cars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_inactive"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Cars"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chip_vans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_inactive"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Vans"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chip_tuktuk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_inactive"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Tuk Tuk"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chip_buses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_inactive"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="Buses"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. DYNAMIC RENTALS RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_rentals_transport"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_chips"
        tools:listitem="@layout/item_rental_transport_card" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_rentals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_chips">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="No Rentals in this Category"
            android:textColor="#1A2B4C"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="Try selecting 'All' or another vehicle category."
            android:textColor="#8A8F98"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
