<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".SettingsActivity">

    <!-- ================= TOP BAR ================= -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-bold"
            android:text="Settings &amp; Preferences"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/btn_share_settings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            app:tint="?attr/colorOnSurface"
            android:contentDescription="Share LankaGo" />
    </LinearLayout>
 
    <!-- ================= SCROLLABLE CONTENT ================= -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- Section 0: User Profile Header Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_settings_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:id="@+id/layout_settings_avatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_settings_avatar"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_circle_avatar"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_admin_profile"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="Profile Picture" />

                        <ImageView
                            android:id="@+id/btn_change_settings_avatar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_white_circle"
                            android:elevation="3dp"
                            android:padding="5dp"
                            android:src="@drawable/ic_camera"
                            app:tint="#1A2B4C"
                            android:contentDescription="Change photo" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layout_settings_user_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_settings_user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="LankaGo Traveler"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tv_settings_user_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="traveler@lankago.lk"
                            android:textColor="#64748B"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap to change photo • View Profile"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#94A3B8"
                        android:contentDescription="Open Profile" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 1: General & Appearance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="GENERAL &amp; APPEARANCE"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Item 0: Dark Mode Toggle -->
                    <RelativeLayout
                        android:id="@+id/row_setting_dark_mode"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon_dark"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_day"
                            app:tint="?attr/colorOnSurface"
                            android:contentDescription="Dark Mode" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon_dark"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Dark Mode"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_dark_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#15888888" />

                    <!-- Item 3: Notifications -->
                    <RelativeLayout
                        android:id="@+id/row_setting_notifications"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_bell"
                            app:tint="#7C3AED"
                            android:contentDescription="Notifications Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon3"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Push Notifications"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_notifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="true" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 2: Connectivity & Travel Tools -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="CONNECTIVITY &amp; TRAVEL TOOLS"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Item 1: Location -->
                    <RelativeLayout
                        android:id="@+id/row_setting_location"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#0284C7"
                            android:contentDescription="Location Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon1"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="GPS &amp; Location"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_loc_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrow1"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:text="Enabled"
                            android:textColor="#10B981"
                            android:textSize="13sp" />
                        <ImageView
                            android:id="@+id/arrow1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <!-- Item 2: Wi-Fi -->
                    <RelativeLayout
                        android:id="@+id/row_setting_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_manage"
                            app:tint="#6366F1"
                            android:contentDescription="WiFi Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon2"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Wi-Fi &amp; Network"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_wifi_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrow2"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:text="Connected"
                            android:textColor="#8A8F98"
                            android:textSize="13sp" />
                        <ImageView
                            android:id="@+id/arrow2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <!-- Item 4: Location Services / Maps -->
                    <RelativeLayout
                        android:id="@+id/row_setting_location_services"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon4"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_nav_map"
                            app:tint="#059669"
                            android:contentDescription="Services Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon4"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Live Route &amp; Maps Tracker"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#15888888" />

                    <!-- Item: Browse Vehicle & Bike Rentals -->
                    <RelativeLayout
                        android:id="@+id/row_setting_rentals"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon_rentals"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_home_rental_car"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="Rentals Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon_rentals"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Browse Vehicle &amp; Bike Rentals"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#15888888" />

                    <!-- Item 5: Offline Downloads -->
                    <RelativeLayout
                        android:id="@+id/row_setting_offline"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon5"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="#D97706"
                            android:contentDescription="Downloads Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon5"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Offline Saved Guides"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Section 3: Support, Data & About -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="DATA &amp; SUPPORT"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:letterSpacing="0.05" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Item 6: Help & Support -->
                    <RelativeLayout
                        android:id="@+id/row_setting_help"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon6"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@android:drawable/ic_menu_help"
                            app:tint="#2563EB"
                            android:contentDescription="Help Icon" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon6"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Help &amp; Emergency Support"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <!-- Item 7: Clear Cache -->
                    <RelativeLayout
                        android:id="@+id/row_setting_clear_cache"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon_cache"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_admin_delete"
                            app:tint="#DC2626"
                            android:contentDescription="Clear Cache" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon_cache"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Clear Storage Cache"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_cache_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrow_cache"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:text="Free up space"
                            android:textColor="#8A8F98"
                            android:textSize="13sp" />
                        <ImageView
                            android:id="@+id/arrow_cache"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <!-- Item 8: Privacy & Terms -->
                    <RelativeLayout
                        android:id="@+id/row_setting_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon_privacy"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_shield"
                            app:tint="#475569"
                            android:contentDescription="Privacy" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon_privacy"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="Privacy &amp; Terms of Service"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9" />

                    <!-- Item 9: About LankaGo -->
                    <RelativeLayout
                        android:id="@+id/row_setting_about"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="16dp">
                        <ImageView
                            android:id="@+id/set_icon_about"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_globe_web"
                            app:tint="#0284C7"
                            android:contentDescription="About" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@id/set_icon_about"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:text="About LankaGo"
                            android:textColor="#1A2B4C"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toStartOf="@id/arrow_about"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:text="v1.0.0"
                            android:textColor="#8A8F98"
                            android:textSize="13sp" />
                        <ImageView
                            android:id="@+id/arrow_about"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#94A3B8"
                            android:contentDescription="Arrow" />
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
