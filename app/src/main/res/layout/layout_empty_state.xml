<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_empty_state_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFD"
    android:padding="24dp">

    <!-- Loading State: Circular Spinner -->
    <ProgressBar
        android:id="@+id/empty_state_progress_bar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:indeterminateTint="#1A56DB"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Empty State Content Container -->
    <LinearLayout
        android:id="@+id/empty_state_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Icon Container with Soft Circle Background -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_circle_indigo_soft">

            <ImageView
                android:id="@+id/iv_empty_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_home_trip_plan"
                app:tint="#1A56DB" />
        </FrameLayout>

        <!-- Empty Title -->
        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="No Trips Planned Yet"
            android:textColor="#0F172A"
            android:textSize="20sp" />

        <!-- Empty Subtitle Description -->
        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="You haven't scheduled any journeys in Sri Lanka yet. Create a custom itinerary or explore destinations."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Call to Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_action"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1A56DB"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Plan a New Trip"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="25dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FFFFFF" />

    </LinearLayout>

</FrameLayout>
