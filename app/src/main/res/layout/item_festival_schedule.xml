<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="16dp">

    <!-- Timeline Indicator (Dot + Vertical Line) -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Outer Ring with Inner Dot -->
        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_circle_indigo_soft">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_purple" />
        </FrameLayout>

        <!-- Vertical Connecting Line -->
        <View
            android:id="@+id/view_timeline_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:background="#D1D5DB" />
    </LinearLayout>

    <!-- Schedule Event Details Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Day Label & Time Tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_schedule_day_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Day 1 - Kumbal Perahera"
                    android:textColor="#5D5FEF"
                    android:textSize="12sp" />

                <!-- Time Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_rating_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_clock_pending"
                        app:tint="#673AB7"
                        android:contentDescription="Time" />

                    <TextView
                        android:id="@+id/tv_schedule_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="07:00 PM"
                        android:textColor="#673AB7"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Event Title -->
            <TextView
                android:id="@+id/tv_schedule_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-black"
                android:text="Opening Ritual &amp; Inner Courtyard Procession"
                android:textColor="#1A2B4C"
                android:textSize="14sp" />

            <!-- Event Description -->
            <TextView
                android:id="@+id/tv_schedule_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="The ceremonial beginning of the pageant featuring sacred drummers, whip-crackers, and the first evening tusker parade."
                android:textColor="#6B7280"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
