<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Plan a New Trip"
                android:textColor="#1A2B4C"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Organize your itinerary and verify traveler identity"
                android:textColor="#8A8F98"
                android:textSize="13sp" />

            <!-- Traveler Type Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Traveler Category"
                android:textColor="#1A2B4C"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rg_traveler_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_local"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Local (NIC)"
                    android:textColor="#1A2B4C"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_foreign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Foreign (Passport)"
                    android:textColor="#1A2B4C"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- ID / Passport Capture Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="ID Verification Document *"
                android:textColor="#1A2B4C"
                android:textSize="13sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_id_capture"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8F9FB">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Placeholder View Before Photo is Captured -->
                    <LinearLayout
                        android:id="@+id/layout_id_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_camera_icon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#5D5FEF"
                            android:contentDescription="Camera" />

                        <TextView
                            android:id="@+id/tv_id_capture_placeholder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Tap to capture NIC"
                            android:textColor="#1A2B4C"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Take a clear photo with camera"
                            android:textColor="#8A8F98"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Captured Photo Preview -->
                    <ImageView
                        android:id="@+id/ivIdCapture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        android:contentDescription="Captured ID Photo" />

                    <!-- Retake Label Overlay when image is set -->
                    <TextView
                        android:id="@+id/tv_retake_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="#99000000"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="Tap to Retake"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Trip Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_trip_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Trip Name (e.g. Ella &amp; Southern Coast)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1A2B4C">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_trip_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="#1A2B4C"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Trip Date Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_trip_date"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Travel Dates (e.g. Oct 24 - Oct 28)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#1A2B4C">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_trip_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="#1A2B4C"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dialog Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cancel_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#8A8F98"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_save_trip_dialog"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_primary"
                    android:paddingHorizontal="20dp"
                    android:text="Save Trip"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
