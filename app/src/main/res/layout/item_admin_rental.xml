<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Rental Thumbnail Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_admin_rental_thumb"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="Rental Photo"
                android:scaleType="centerCrop"
                android:src="@drawable/casons_rent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <!-- Shop Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_admin_rental_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textColor="#1A2B4C"
                    android:textSize="16sp"
                    tools:text="Epic Ride Scooter Rental" />

                <TextView
                    android:id="@+id/tv_admin_rental_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="#8A8F98"
                    android:textSize="12sp"
                    tools:text="Galle Fort · Sri Lanka" />

                <TextView
                    android:id="@+id/tv_admin_rental_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="#5D5FEF"
                    android:textSize="12sp"
                    tools:text="07:30 AM – 09:30 PM" />

                <TextView
                    android:id="@+id/tv_admin_rental_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="#10B981"
                    android:textSize="13sp"
                    tools:text="LKR 3,500/day" />
            </LinearLayout>

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#F0F2F5" />

        <!-- Bottom Action Bar (Edit & Delete) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_admin_rental_contact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="#8A8F98"
                android:textSize="12sp"
                tools:text="Tel: +94912248899" />

            <!-- Edit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_rental"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-bold"
                android:text="Edit"
                android:textColor="#5D5FEF"
                android:textSize="12sp"
                app:icon="@drawable/ic_admin_edit"
                app:iconTint="#5D5FEF" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_rental"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-bold"
                android:text="Delete"
                android:textColor="#EF4444"
                android:textSize="12sp"
                app:icon="@drawable/ic_admin_delete"
                app:iconTint="#EF4444" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
