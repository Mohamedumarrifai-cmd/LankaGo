<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- 1. Full-Screen Interactive OpenStreetMap (Leaflet.js - 100% Free, No API Key Required) -->
    <WebView
        android:id="@+id/map_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Floating Top Search Card & Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Destination Input Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_destination_search"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Search Icon"
                    android:src="@drawable/ic_admin_search"
                    app:tint="?attr/colorPrimary" />

                <EditText
                    android:id="@+id/et_destination_query"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="Search destination (e.g., Galle Fort)..."
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_clear_query"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear search"
                    android:src="@drawable/ic_admin_delete"
                    android:visibility="gone"
                    app:tint="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- "Find Route" CTA Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_find_route"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-bold"
            android:text="Find Route"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="13sp"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="22dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_nav_map"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorOnPrimary" />

        <!-- Live Current Location GPS Coordinates Card (Matching Tutorial Spec) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_current_location_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_map_pin"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="GPS Location" />

                <TextView
                    android:id="@+id/locationTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Location: Waiting for GPS..."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_gps_live_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_approved"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="LIVE GPS"
                    android:textColor="#065F46"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 3. Progress Bar for Live Routing Requests -->
    <ProgressBar
        android:id="@+id/pb_map_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:layout_marginTop="130dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorSecondary"
        android:visibility="gone" />

    <!-- 4. Floating Action Button: Re-center on My Location -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_recenter_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:contentDescription="Re-center on My Current Location"
        android:src="@drawable/ic_my_location"
        app:backgroundTint="@color/surface_card"
        app:elevation="6dp"
        app:fabSize="normal"
        app:tint="?attr/colorPrimary" />

    <!-- 5. Floating Bottom Info Card: Distance & ETA -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_route_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Header: Title & Close Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/btn_close_summary"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dest_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:text="Galle Dutch Fort"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tv_dest_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="Southern Province, Sri Lanka"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_close_summary"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close route"
                    android:padding="4dp"
                    android:src="@drawable/ic_admin_delete"
                    app:tint="@color/text_secondary" />
            </RelativeLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/border" />

            <!-- Stats: Distance & ETA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Distance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Total Distance"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_route_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="128 km"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Vertical Divider -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@color/border" />

                <!-- ETA -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Estimated Time"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_route_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="2 hr 15 mins"
                        android:textColor="?attr/colorSecondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Navigate Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_launch_navigation"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="14dp"
                    android:text="Navigate"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSecondary"
                    android:textSize="12sp"
                    app:backgroundTint="?attr/colorSecondary"
                    app:cornerRadius="20dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
