<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_trip_history_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Top Header: Status Chip & Destination -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_history_trip_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:textColor="#0F172A"
                android:textSize="17sp"
                tools:text="Ella Adventure (2 Travelers)" />

            <TextView
                android:id="@+id/tv_history_trip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:backgroundTint="#EFF6FF"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Upcoming"
                android:textColor="#1A56DB"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Date & Location Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tv_history_trip_dates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:text="Oct 24 - Oct 28, 2026" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/dot_active"
                android:backgroundTint="#CBD5E1" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_map_pin"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tv_history_trip_destination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#334155"
                android:textSize="13sp"
                tools:text="Ella, Sri Lanka" />
        </LinearLayout>

        <!-- Details Badges (Rentals, Activities, Places) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_history_badge_rentals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:backgroundTint="#F8FAFC"
                android:drawableStart="@drawable/ic_home_rental_car"
                android:drawablePadding="6dp"
                android:drawableTint="#475569"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="0 Rentals"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_history_badge_activities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="#F8FAFC"
                android:drawableStart="@drawable/ic_home_artisan"
                android:drawablePadding="6dp"
                android:drawableTint="#475569"
                android:fontFamily="sans-serif"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="0 Activities"
                android:textColor="#475569"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Action: View Itinerary -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Details"
                    android:textColor="#1A56DB"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#1A56DB" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
